---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Harley Landscaping" description="That page doesn't exist." noindex>
  <section class="sec sec-moss page-top" style="min-height:60vh">
    <div class="wrap narrow">
      <p class="kicker">404</p>
      <h1>This page got mowed.</h1>
      <p class="lead">It doesn’t exist anymore. Head home or grab a free estimate.</p>
      <div class="btn-row"><a href="/" class="btn btn-lime">Back to home</a><a href="/#estimate" class="btn btn-ghost">Free estimate</a></div>
    </div>
  </section>
</Base>
