---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Privacy Policy | Harley Landscaping" description="How Harley Landscaping handles the information you send through this website.">
  <section class="sec page-top">
    <div class="wrap narrow prose">
      <p class="kicker">Privacy</p>
      <h1>Privacy policy</h1>
      <p>When you request an estimate, we collect what you type into the form (name, phone, town, the service you want, and any notes) so we can contact you about your yard. We don’t sell or share it.</p>
      <p>The site uses basic analytics and remembers how you arrived (for example, from a Google ad) so we know which ads and pages work. No payment details are collected here.</p>
      <p>Questions or want your info deleted? Call or text {site.phone}.</p>
    </div>
  </section>
</Base>
