---
import { img, srcset } from '../lib/img';
interface Props {
  src: string;
  alt: string;
  sizes?: string;
  width?: number;
  height?: number;
  eager?: boolean;
  class?: string;
}
const { src, alt, sizes = '(max-width: 880px) 100vw, 50vw', width = 800, height = 1000, eager = false, class: cls } = Astro.props;
---
<img
  class={cls}
  src={img(src, width)}
  srcset={srcset(src)}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
